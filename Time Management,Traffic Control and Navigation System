#include<iostream>
#include<vector>
#include<climits>
#include<queue>
#include<ctime>
#include<algorithm>
using namespace std;
struct Edge{
    int destination;
    int weight;
    int traffic;
};
class Graph{
    int vertices;
    vector<vector<Edge>>adjlist;
    public:
    Graph(int V){
        vertices=V;
     adjlist.resize(vertices);
    }
    void addEdge(int source,int destination,int weight,int traffic){
        adjlist[source].push_back({destination,weight,traffic});
        adjlist[destination].push_back({source,weight,traffic});
    }
    void display(){
    cout<<"Road Display:-"<<endl;
        int i;
        for(i=0;i<vertices;i++){
            cout<<i<<"->";
            for(auto adj:adjlist[i]){
                cout<<"("<<"Destination:"<<adj.destination<<" "<<"Weight:" <<adj.weight<<" "<<"Traffic:"<<adj.traffic<<")"<<" ";
            }
            cout<<endl;
        }
    }
    void simulateTraffic(){
        int i;
        for(i=0;i<vertices;i++){
            for(auto &e:adjlist[i]){
                e.traffic=rand()%10;
            }
        }
    }

     void dijkstra(int source, int destination) {
        vector<int>dist(vertices,INT_MAX);
        vector<int>parent(vertices,-1);
        priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;
        dist[source] = 0;
        pq.push({0, source});
        while (!pq.empty()) {
            auto top = pq.top();
            pq.pop();
            int currDist = top.first;
            int node = top.second;
            for (auto &e : adjlist[node]) {
                int cost = e.weight + e.traffic;
               if (currDist + cost < dist[e.destination]) {
                    dist[e.destination] = currDist + cost;
                    parent[e.destination] = node;
                    pq.push({dist[e.destination], e.destination});
                }
            }
        }
        if (dist[destination] == INT_MAX) {
            cout << "No path found!\n";
            return;
        }

        cout << "Shortest Time:"<<dist[destination] << endl;
        vector<int> path;
        for (int v = destination; v != -1; v = parent[v]) {
            path.push_back(v);
        }

        reverse(path.begin(),path.end());
        cout << "Path: ";
        for (int i = 0; i < path.size(); i++) {
            cout << path[i];
            if (i != path.size() - 1) cout << " -> ";
        }
        cout << endl;
    }
    int heuristic(int u, int v){
    return abs(u - v);
}

    void aStar(int source, int destination) {
    vector<int>gScore(vertices, INT_MAX);
    vector<int>fScore(vertices, INT_MAX);
    vector<int>parent(vertices, -1);

    priority_queue<pair<int,int>, vector<pair<int,int>>, greater<pair<int,int>>> pq;

    gScore[source] = 0;
    fScore[source] = heuristic(source, destination);

    pq.push({fScore[source], source});

    while (!pq.empty()) {
        int node = pq.top().second;
        pq.pop();

        if (node == destination) break;

        for (auto &e : adjlist[node]) {
            int tentative_g = gScore[node] + e.weight + e.traffic;

            if (tentative_g < gScore[e.destination]) {
                gScore[e.destination] = tentative_g;
                fScore[e.destination] = tentative_g + heuristic(e.destination, destination);
                parent[e.destination] = node;

                pq.push({fScore[e.destination], e.destination});
            }
        }
    }

    if (gScore[destination] == INT_MAX) {
        cout << "No path found!\n";
        return;
    }

    cout << "[A*] Shortest Time: " << gScore[destination] << endl;

    vector<int> path;
    for (int v = destination; v != -1; v = parent[v]) {
        path.push_back(v);
    }

    reverse(path.begin(), path.end());

    cout << "[A*] Path: ";
    for (int i = 0; i < path.size(); i++) {
        cout << path[i];
        if (i != path.size() - 1) cout << " -> ";
    }
    cout << endl;
}
};
int main(){
    int choice;
    int source,destination,vertices;
    cout<<"Enter the vertices:";
    cin>>vertices;
    Graph g(vertices);
    g.addEdge(0,1,10,0);
    g.addEdge(0,2,5,0);
    g.addEdge(1,2,2,0);
    g.addEdge(1,3,1,0);
    g.addEdge(2,3,9,0);
    g.addEdge(3,4,4,0); 
    srand(time(0));
    while(true){
        cout<<"Enter source and destination:";
        cin>>source>>destination;
        if(source<0 || source>=vertices || destination<0 || destination>=vertices){
            cout<<"Invalid Choice";
            return 0;
        }
    g.simulateTraffic();
    g.display();
    g.dijkstra(source,destination);
    g.aStar(source, destination);
cout<<"1. To continue"<<" "<<"0. To Exit"<<":";
cin>>choice;
if(choice==0) 
break;}
return 0;
}
